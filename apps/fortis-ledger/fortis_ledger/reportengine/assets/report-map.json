  "xero_code_map": {
    "_comment": "Where each Xero report code used in the firm charts prints. The longest matching code prefix wins (e.g. LIA.CUR.PAY.EMP before LIA.CUR.PAY before LIA.CUR). 'slot' is a layout position - one of the codes used by pnl_sections / bs_lines / notes below, which can also be used directly as a report code. 'refine' = [[regex on the account name, slot], ...] tried first - only used where one Xero code holds accounts of different natures. 'ppe_class': the Property, Plant and Equipment class comes from the account name (ppe_classes), else from the code (ppe_class_by_code). A trailing .1 .2 ... (EQU.ADV.1, EQU.DRA.2, EQU.PFT.3) is kept as the partner / beneficiary number. Change where a code prints here; change which code an account carries in the chart CSV (scripts/chart.py set-code) or per client (build_pack.py --set-code).",
    "ASS": {
      "slot": "ASS.CUR.OTH"
    },
    "ASS.CUR": {
      "slot": "ASS.CUR.OTH",
      "note": "Suspense - should be nil at year end"
    },
    "ASS.CUR.CAS": {
      "slot": "ASS.CUR.CAS.OTH",
      "note": "cash on hand, petty cash"
    },
    "ASS.CUR.CAS.BAN": {
      "slot": "ASS.CUR.CAS.BAN"
    },
    "ASS.CUR.TER": {
      "slot": "ASS.CUR.FIN",
      "refine": [
        [
          "debtor",
          "ASS.CUR.REC"
        ]
      ],
      "note": "term / short-term deposits -> Financial Assets (Current); term debtors -> Receivables"
    },
    "ASS.CUR.INY": {
      "slot": "ASS.CUR.INV.INV"
    },
    "ASS.CUR.INY.WIP": {
      "slot": "ASS.CUR.INV.WIP"
    },
    "ASS.CUR.REC": {
      "slot": "ASS.CUR.REC"
    },
    "ASS.CUR.REC.PRE": {
      "slot": "ASS.CUR.PRE"
    },
    "ASS.CUR.REL": {
      "slot": "ASS.CUR.REC"
    },
    "ASS.CUR.LOA": {
      "slot": "ASS.CUR.REC"
    },
    "ASS.NCA": {
      "slot": "ASS.NCA.OTH"
    },
    "ASS.NCA.FIX": {
      "slot": "ASS.NCA.PPE",
      "ppe_class": true,
      "note": "class follows the code (PLA plant, office equipment, furniture; VEH motor vehicles; LEA leasehold improvements; LAC/BUC land and buildings); depreciation pools and staff amenities inside BUC are refined by name"
    },
    "ASS.NCA.INT": {
      "slot": "ASS.NCA.INT.OTH"
    },
    "ASS.NCA.INT.GOO": {
      "slot": "ASS.NCA.INT.GOO"
    },
    "ASS.NCA.INV": {
      "slot": "ASS.NCA.INV"
    },
    "ASS.NCA.INV.TER": {
      "slot": "ASS.NCA.REC",
      "refine": [
        [
          "term deposit|investment",
          "ASS.NCA.FIN"
        ]
      ],
      "note": "deposits / bonds paid -> Receivables (Non Current); term deposits -> Financial Assets (Non Current)"
    },
    "LIA": {
      "slot": "LIA.CUR.PAY"
    },
    "LIA.CUR": {
      "slot": "LIA.CUR.PAY",
      "note": "Historical adjustment / rounding / tracking - should be nil"
    },
    "LIA.CUR.PAY": {
      "slot": "LIA.CUR.PAY"
    },
    "LIA.CUR.PAY.TRA": {
      "slot": "LIA.CUR.PAY"
    },
    "LIA.CUR.PAY.EMP": {
      "slot": "LIA.CUR.EMP"
    },
    "LIA.CUR.PAY.PAY": {
      "slot": "LIA.CUR.EMP",
      "note": "PAYG withholding, wages and leave payable print under Personnel-related items (Happy Inn, a firm-chart client)"
    },
    "LIA.CUR.TAX": {
      "slot": "LIA.CUR.TAX",
      "refine": [
        [
          "dividend",
          "LIA.CUR.PRO"
        ]
      ]
    },
    "LIA.CUR.PRO": {
      "slot": "LIA.CUR.PRO"
    },
    "LIA.CUR.LOA": {
      "slot": "LIA.CUR.FIN",
      "refine": [
        [
          "visa|master ?card|amex|american express|diners|bank ?card|credit card",
          "LIA.CUR.PAY"
        ]
      ],
      "note": "credit cards -> Payables > Current (RSJ, Argo, Elladdin); bank and other loans -> Financial Liabilities > Current"
    },
    "LIA.CUR.HPA": {
      "slot": "LIA.CUR.FIN"
    },
    "LIA.NCL": {
      "slot": "LIA.NCA.OTH",
      "note": "borrowing clearing accounts - should be nil"
    },
    "LIA.NCL.LOA": {
      "slot": "LIA.NCA.FIN"
    },
    "LIA.NCL.LOA.DIR": {
      "slot": "LIA.NCA.FIN.UNS"
    },
    "LIA.NCL.LOA.UNS": {
      "slot": "LIA.NCA.FIN.UNS"
    },
    "LIA.NCL.LOA.SET": {
      "slot": "LIA.NCA.FIN.UNS"
    },
    "LIA.NCL.LOA.SEC": {
      "slot": "LIA.NCA.FIN.SEC"
    },
    "LIA.NCL.REL": {
      "slot": "LIA.NCA.FIN.UNS"
    },
    "LIA.NCL.CHM": {
      "slot": "LIA.NCA.FIN.SEC"
    },
    "LIA.NCL.HPA": {
      "slot": "LIA.NCA.FIN.SEC"
    },
    "LIA.NCL.UDL": {
      "slot": "LIA.NCA.PRO"
    },
    "LIA.NCL.PFT": {
