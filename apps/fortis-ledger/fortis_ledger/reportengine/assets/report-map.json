    },
    "EQU.RES": {
      "slot": "EQU.RES"
    },
    "EQU.RET": {
      "slot": "EQU.RET"
    },
    "EQU.RET.CUR": {
      "slot": "EQU.CYE"
    },
    "EQU.RET.DIV": {
      "slot": "EQU.DIV"
    },
    "EQU.SET": {
      "slot": "EQU.SET"
    },
    "EQU.ADV": {
      "slot": "EQU.CAP"
    },
    "EQU.DRA": {
      "slot": "EQU.DRA"
    },
    "EQU.PFT": {
      "slot": "EQU.PFT"
    },
    "EQU.UDE": {
      "slot": "EQU.OTH"
    },
    "REV": {
      "slot": "REV.TRA"
    },
    "REV.TRA": {
      "slot": "REV.TRA"
    },
    "REV.OTH": {
      "slot": "REV.OTH"
    },
    "REV.INV": {
      "slot": "REV.OTH"
    },
    "REV.GRA": {
      "slot": "REV.OTH"
    },
    "EXP": {
      "slot": "EXP.OPE"
    },
    "EXP.COS": {
      "slot": "EXP.COS"
    },
    "EXP.INC": {
      "slot": "EXP.TAX"
    },
    "EXP.DIV": {
      "slot": "EQU.DIV"
    },
    "EXP.DIS": {
