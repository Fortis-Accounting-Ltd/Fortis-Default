{
  "_comment": "Report-code hierarchy that drives the Financial Reports pack. Modelled on Xero's report codes (REV/EXP/ASS/LIA/EQU). Every account in the ledger carries one report_code; the engine derives the P&L sections, Balance Sheet lines, Note numbers and Note sub-groups from this file. Edit labels/order here rather than in the scripts.",
  "pnl_sections": [
    {
      "key": "income",
      "code": "REV.TRA",
      "heading": "Income",
      "total": "Total Income"
    },
    {
      "key": "cos",
      "code": "EXP.COS",
      "heading": "Cost of Sales",
      "total": "Total Cost of Sales",
      "alt_headings": {
        "Cost of Goods Sold": "Total Cost of Goods Sold"
      }
    },
    {
      "key": "gross",
      "computed": true,
      "label": "Gross Profit from Trading"
    },
    {
      "key": "other",
      "code": "REV.OTH",
      "heading": "Other Income",
      "total": "Total Other Income"
    },
    {
      "key": "total_income",
      "computed": true,
      "label": "Total Income"
    },
    {
      "key": "expenses",
      "code": "EXP.OPE",
      "heading": "Expenses",
      "total": "Total Expenses"
    },
    {
      "key": "pbt",
      "computed": true,
      "label": "Profit/(Loss) before Taxation"
    },
    {
      "key": "tax",
      "code": "EXP.TAX",
      "heading": "Income Tax Expense",
      "total": "Total Income Tax Expense",
      "hide_if_nil": true
    },
    {
      "key": "npat",
      "computed": true,
      "label": "Net Profit After Tax"
    },
    {
      "key": "dividends",
      "code": "EQU.DIV",
      "heading": "Dividend Paid",
      "total": "Total Dividend Paid",
      "hide_if_nil": true
    },
    {
      "key": "npat_div",
      "computed": true,
      "label": "Net Profit After Tax & Dividend"
    }
  ],
  "balance_sheet": {
    "assets": {
      "heading": "Assets",
      "current": {
        "heading": "Current Assets",
        "total": "Total Current Assets",
        "prefix": "ASS.CUR"
      },
      "non_current": {
        "heading": "Non-Current Assets",
        "total": "Total Non-Current Assets",
        "prefix": "ASS.NCA"
      },
      "total": "Total Assets"
    },
    "liabilities": {
      "heading": "Liabilities",
      "current": {
        "heading": "Current Liabilities",
        "total": "Total Current Liabilities",
        "prefix": "LIA.CUR"
      },
      "non_current": {
        "heading": "Non-Current Liabilities",
        "total": "Total Non-Current Liabilities",
        "prefix": "LIA.NCA"
      },
      "total": "Total Liabilities"
    },
    "net_assets": "Net Assets",
    "equity": {
      "heading": "Equity",
      "total": "Total Equity",
      "prefix": "EQU"
    }
  },
  "_bs_lines_comment": "Balance Sheet line = the 3-segment code (e.g. ASS.CUR.CAS). Each line points to the note it is disclosed in. Lines with a nil total in both years are suppressed; the note still prints if any account inside it is non-nil.",
