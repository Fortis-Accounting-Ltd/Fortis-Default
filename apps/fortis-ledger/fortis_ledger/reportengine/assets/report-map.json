  "_notes_comment": "Notes print in this order, numbered from 2 (Note 1 is always the accounting policies). 'levels' says how the sub-headings inside the note are derived from the report code: 'cur_ncu' = Current / Non Current from the 3rd segment; 'class' = the 4th segment via 'classes'; 'flat' = no sub-heading. 'level2' adds a third tier (e.g. Unsecured) from the 5th segment.",
  "notes_order": [
    "cash",
    "receivables",
    "inventory",
    "prepayments",
    "ppe",
    "financial_assets",
    "intangibles",
    "investments",
    "other_assets",
    "payables",
    "provisions",
    "financial_liabilities",
    "shareholder_loans",
    "beneficiary_entitlements",
    "other_liabilities",
    "reserves"
  ],
  "notes": {
    "cash": {
      "title": "Cash and Cash Equivalents",
      "total": "Total Cash and Cash Equivalents",
      "levels": "class",
      "classes": {
        "BAN": "Bank Accounts",
        "OTH": "Other Cash Items",
        "TRM": "Term Deposits"
      },
      "default_class": "BAN"
    },
    "receivables": {
      "title": "Receivables",
      "total": "Total Receivables",
      "levels": "cur_ncu",
      "cur_label": "Current",
      "ncu_label": "Non Current"
    },
    "inventory": {
      "title": "Inventory",
      "total": "Total Inventory",
      "levels": "class",
      "classes": {
        "INV": "Inventories",
        "WIP": "Work in Progress"
      },
      "default_class": "INV"
    },
    "prepayments": {
      "title": "Prepayments",
      "total": "Total Prepayments",
      "levels": "flat"
