        "LVP": "Low Value Pool",
        "OTH": "Other Fixed Assets",
        "POL": "Pooled Assets"
      },
      "default_class": "PLA",
      "line_style": "class",
      "_line_style_comment": "class = one cost line and one accumulated depreciation line per class, labelled '<Class> at Cost' / 'Accumulated Depreciation of <Class>' (what every Xero pack prints); accounts in the 'Other Fixed Assets' class keep their own names. options.ppe_note_lines = 'accounts' lists every account instead."
    },
    "intangibles": {
      "title": "Intangibles",
      "total": "Total Intangibles",
      "levels": "class",
      "classes": {
        "GOO": "Goodwill",
        "OTH": "Other Intangible Assets",
