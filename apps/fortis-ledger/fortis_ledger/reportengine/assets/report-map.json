  "entity_layouts": {
    "_comment": "Per-entity layout of the pack, laid over the company defaults above. reports = print order (a report with nothing to show is skipped); pnl_sections = P&L sections and computed lines (formula add/sub of section keys; sign -1 prints a section reversed; collapse_label prints the section's own-code accounts as one line; also_codes pulls other codes into the section; rental_line adds the net Rental Schedule line); bs_equity = Balance Sheet equity lines (value = an equity total, label '@accounts' lists the accounts by name, always = print even when nil); persons = Partner / Beneficiary Accounts statement; distribution_statement = Trust Income Distribution; rental_schedule = take rental accounts (REV.INV.REN / EXP.INV.REN) out of the P&L body; options = defaults the pack's own options override. Built from the firm's Xero packs in FYI (references/entity-types.md).",
    "company": {
      "reports": [
        "pnl",
        "bs",
        "equity",
        "notes",
        "depreciation",
        "declaration",
        "compilation"
      ],
      "bs_equity": [
        {
          "value": "retained_display",
          "label": "Retained Earnings"
        },
        {
          "value": "reserves",
          "label": "Reserves"
        },
        {
          "value": "share_capital",
          "label": "Share Capital"
        },
